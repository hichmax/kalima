# Nom et URL publics
NEXT_PUBLIC_APP_NAME=Kalima
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Quran.Foundation Content API — secrets serveur uniquement (traduction + récitation).
# Sans ces valeurs, l'application fonctionne avec le texte Tanzil, sans audio ni traduction.
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# "production" pour les identifiants de production, "prelive" pour ceux de test
# (prelive ne contient que les sourates 1 et 2).
QF_ENV=production
QF_TRANSLATION_ID=31
QF_RECITATION_ID=7
# Facultatif : forcer un scope. Par défaut, Kalima essaie les scopes granulaires
# (content.quran.read content.translations.read content.audio.read) puis « content ».
# QF_SCOPE=content
