# Nom et URL publics
NEXT_PUBLIC_APP_NAME=Kalima
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Quran.Foundation Content API — secrets serveur uniquement (traduction + récitation).
# Sans ces valeurs, l'application fonctionne avec le texte Tanzil, sans audio ni traduction.
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# "production" pour les identifiants de production, "prelive" pour ceux de test
# (prelive ne contient que les sourates 1 et 2).
QF_ENV=production
QF_TRANSLATION_ID=31
QF_RECITATION_ID=7
# Facultatif : forcer un scope. Par défaut, Kalima essaie les scopes granulaires
# (content.quran.read content.translations.read content.audio.read) puis « content ».
# QF_SCOPE=content

# Comptes (Better Auth 1.7 + Neon Postgres). Sans ces valeurs, l'application reste
# 100 % locale : la progression vit sur l'appareil, la page de connexion affiche une erreur douce.
# Base : chaîne de connexion Postgres (Neon, « pooled »).
DATABASE_URL=
# Secret de signature des sessions : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique du site. En production : https://ton-domaine ; à laisser vide pour les Preview Vercel
# (Better Auth la déduit alors de la requête).
BETTER_AUTH_URL=http://localhost:3000
# Facultatif : connexion avec Google (redirection : <URL>/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
