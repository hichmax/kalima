# Nom affiché dans l'application
NEXT_PUBLIC_APP_NAME=Kalima
NEXT_PUBLIC_APP_URL=http://localhost:3000
# "hybrid" en local ; "browser" sur Vercel pour une progression 100 % locale
NEXT_PUBLIC_STORAGE_MODE=hybrid

# Base locale SQLite — chemin relatif au projet ou chemin absolu
KALIMA_DATABASE_PATH=./data/kalima.db

# Quran Foundation Content API — secrets serveur uniquement
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_ENV=prelive
QF_TRANSLATION_ID=31
QF_RECITATION_ID=7

# Protection de l'espace de validation interne
ADMIN_REVIEW_EMAILS=
INTERNAL_REVIEW_TOKEN=

# Optionnel : stockage d'audio hors ligne
NEXT_PUBLIC_AUDIO_CACHE_MAX_MB=250
