ٍ"},{"ar":"مَّهِينٍ"}]},{"v":9,"w":[{"ar":"ثُمَّ"},{"ar":"سَوَّىٰهُ"},{"ar":"وَنَفَخَ"},{"ar":"فِيهِ"},{"ar":"مِن"},{"ar":"رُّوحِهِۦ","stop":"ۖ"},{"ar":"وَجَعَلَ"},{"ar":"لَكُمُ"},{"ar":"ٱلسَّمْعَ"},{"ar":"وَٱلْأَبْصَـٰرَ"},{"ar":"وَٱلْأَفْـِٔدَةَ","stop":"ۚ"},{"ar":"قَلِيلًا"},{"ar":"مَّا"},{"ar":"تَشْكُرُونَ"}]},{"v":10,"w":[{"ar":"وَقَالُوٓا۟"},{"ar":"أَءِذَا"},{"ar":"ضَلَلْنَا"},{"ar":"فِى"},{"ar":"ٱلْأَرْضِ"},{"ar":"أَءِنَّا"},{"ar":"لَفِى"},{"ar":"خَلْقٍ"},{"ar":"جَدِيدٍۭ","stop":"ۚ"},{"ar":"بَلْ"},{"ar":"هُم"},{"ar":"بِلِقَآءِ"},{"ar":"رَبِّهِمْ"},{"ar":"كَـٰفِرُونَ"}]},{"v":11,"w":[{"ar":"قُلْ"},{"ar":"يَتَوَفَّىٰكُم"},{"ar":"مَّلَكُ"},{"ar":"ٱلْمَوْتِ"},{"ar":"ٱلَّذِى"},{"ar":"وُكِّلَ"},{"ar":"بِكُمْ"},{"ar":"ثُمَّ"},{"ar":"إِلَىٰ"},{"ar":"رَبِّكُمْ"},{"ar":"تُرْجَعُونَ"}]},{"v":12,"w":[{"ar":"وَلَوْ"},{"ar":"تَرَىٰٓ"},{"ar":"إِذِ"},{"ar":"ٱلْمُجْرِمُونَ"},{"ar":"نَاكِسُوا۟"},{"ar":"رُءُوسِهِمْ"},{"ar":"عِندَ"},{"ar":"رَبِّهِمْ"},{"ar":"رَبَّنَآ"},{"ar":"أَبْصَرْنَا"},{"ar":"وَسَمِعْنَا"},{"ar":"فَٱرْجِعْنَا"},{"ar":"نَعْمَلْ"},{"ar":"صَـٰلِحًا"},{"ar":"إِنَّا"},{"ar":"مُوقِنُونَ"}]},{"v":13,"w":[{"ar":"وَلَوْ"},{"ar":"شِئْنَا"},{"ar":"لَـَٔاتَيْنَا"},{"ar":"كُلَّ"},{"ar":"نَفْسٍ"},{"ar":"هُدَىٰهَا"},{"ar":"وَلَـٰكِنْ"},{"ar":"حَقَّ"},{"ar":"ٱلْقَوْلُ"},{"ar":"مِنِّى"},{"ar":"لَأَمْلَأَنَّ"},{"ar":"جَهَنَّمَ"},{"ar":"مِنَ"},{"ar":"ٱلْجِنَّةِ"},{"ar":"وَٱلنَّاسِ"},{"ar":"أَجْمَعِينَ"}]},{"v":14,"w":[{"ar":"فَذُوقُوا۟"},{"ar":"بِمَا"},{"ar":"نَسِيتُمْ"},{"ar":"لِقَآءَ"},{"ar":"يَوْمِكُمْ"},{"ar":"هَـٰذَآ"},{"ar":"إِنَّا"},{"ar":"نَسِينَـٰكُمْ","stop":"ۖ"},{"ar":"وَذُوقُوا۟"},{"ar":"عَذَابَ"},{"ar":"ٱلْخُلْدِ"},{"ar":"بِمَا"},{"ar":"كُنتُمْ"},{"ar":"تَعْمَلُونَ"}]},{"v":15,"w":[{"ar":"إِنَّمَا"},{"ar":"يُؤْمِنُ"},{"ar":"بِـَٔايَـٰتِنَا"},{"ar":"ٱلَّذِينَ"},{"ar":"إِذَا"},{"ar":"ذُكِّرُوا۟"},{"ar":"بِهَا"},{"ar":"خَرُّوا۟"},{"ar":"سُجَّدًا"},{"ar":"وَسَبَّحُوا۟"},{"ar":"بِحَمْدِ"},{"ar":"رَبِّهِمْ"},{"ar":"وَهُمْ"},{"ar":"لَا"},{"ar":"يَسْتَكْبِرُونَ","stop