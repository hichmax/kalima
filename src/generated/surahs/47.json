ُ"},{"ar":"عَمَلِهِۦ"},{"ar":"وَٱتَّبَعُوٓا۟"},{"ar":"أَهْوَآءَهُم"}]},{"v":15,"w":[{"ar":"مَّثَلُ"},{"ar":"ٱلْجَنَّةِ"},{"ar":"ٱلَّتِى"},{"ar":"وُعِدَ"},{"ar":"ٱلْمُتَّقُونَ","stop":"ۖ"},{"ar":"فِيهَآ"},{"ar":"أَنْهَـٰرٌ"},{"ar":"مِّن"},{"ar":"مَّآءٍ"},{"ar":"غَيْرِ"},{"ar":"ءَاسِنٍ"},{"ar":"وَأَنْهَـٰرٌ"},{"ar":"مِّن"},{"ar":"لَّبَنٍ"},{"ar":"لَّمْ"},{"ar":"يَتَغَيَّرْ"},{"ar":"طَعْمُهُۥ"},{"ar":"وَأَنْهَـٰرٌ"},{"ar":"مِّنْ"},{"ar":"خَمْرٍ"},{"ar":"لَّذَّةٍ"},{"ar":"لِّلشَّـٰرِبِينَ"},{"ar":"وَأَنْهَـٰرٌ"},{"ar":"مِّنْ"},{"ar":"عَسَلٍ"},{"ar":"مُّصَفًّى","stop":"ۖ"},{"ar":"وَلَهُمْ"},{"ar":"فِيهَا"},{"ar":"مِن"},{"ar":"كُلِّ"},{"ar":"ٱلثَّمَرَٰتِ"},{"ar":"وَمَغْفِرَةٌ"},{"ar":"مِّن"},{"ar":"رَّبِّهِمْ","stop":"ۖ"},{"ar":"كَمَنْ"},{"ar":"هُوَ"},{"ar":"خَـٰلِدٌ"},{"ar":"فِى"},{"ar":"ٱلنَّارِ"},{"ar":"وَسُقُوا۟"},{"ar":"مَآءً"},{"ar":"حَمِيمًا"},{"ar":"فَقَطَّعَ"},{"ar":"أَمْعَآءَهُمْ"}]},{"v":16,"w":[{"ar":"وَمِنْهُم"},{"ar":"مَّن"},{"ar":"يَسْتَمِعُ"},{"ar":"إِلَيْكَ"},{"ar":"حَتَّىٰٓ"},{"ar":"إِذَا"},{"ar":"خَرَجُوا۟"},{"ar":"مِنْ"},{"ar":"عِندِكَ"},{"ar":"قَالُوا۟"},{"ar":"لِلَّذِينَ"},{"ar":"أُوتُوا۟"},{"ar":"ٱلْعِلْمَ"},{"ar":"مَاذَا"},{"ar":"قَالَ"},{"ar":"ءَانِفًا","stop":"ۚ"},{"ar":"أُو۟لَـٰٓئِكَ"},{"ar":"ٱلَّذِينَ"},{"ar":"طَبَعَ"},{"ar":"ٱللَّهُ"},{"ar":"عَلَىٰ"},{"ar":"قُلُوبِهِمْ"},{"ar":"وَٱتَّبَعُوٓا۟"},{"ar":"أَهْوَآءَهُمْ"}]},{"v":17,"w":[{"ar":"وَٱلَّذِينَ"},{"ar":"ٱهْتَدَوْا۟"},{"ar":"زَادَهُمْ"},{"ar":"هُدًى"},{"ar":"وَءَاتَىٰهُمْ"},{"ar":"تَقْوَىٰهُمْ"}]},{"v":18,"w":[{"ar":"فَهَلْ"},{"ar":"يَنظُرُونَ"},{"ar":"إِلَّا"},{"ar":"ٱلسَّاعَةَ"},{"ar":"أَن"},{"ar":"تَأْتِيَهُم"},{"ar":"بَغْتَةً","stop":"ۖ"},{"ar":"فَقَدْ"},{"ar":"جَآءَ"},{"ar":"أَشْرَاطُهَا","stop":"ۚ"},{"ar":"فَأَنَّىٰ"},{"ar":"لَهُمْ"},{"ar":"إِذَا"},{"ar":"جَآءَتْهُمْ"},{"ar":"ذِكْرَىٰهُمْ"}]},{"v":19,"w":[{"ar":"فَٱعْلَمْ"},{"ar":"أَنَّهُۥ"},{"ar":"لَآ"},{"ar":"إِلَـٰهَ"},{"ar":"إِلَّا"},{"ar":"ٱللَّهُ"},{"ar":"وَٱسْتَغْفِرْ"},{"ar":"لِذَنۢبِكَ"},{"ar":"وَلِلْمُؤْمِنِينَ"},