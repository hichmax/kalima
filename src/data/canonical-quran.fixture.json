  "expectedSha256": "2c19213f49cbd538895537faffabbf4ac9bc8f77a1389ad56a595d703a78fb7f",
  "ayahs": [
    { "id": "1:1", "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ" },
    { "id": "1:2", "text": "ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ" },
    { "id": "1:3", "text": "ٱلرَّحْمَٰنِ ٱلرَّحِيمِ" },
    { "id": "1:4", "text": "مَٰلِكِ يَوْمِ ٱلدِّينِ" },
    { "id": "1:5", "text": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ" },
    { "id": "1:6", "text": "ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ" },
    { "id": "1:7", "text": "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ" }
  ]
}
