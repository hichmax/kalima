{
  "name": "kalima",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run content:check && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:build": "node scripts/build-content.mjs",
    "content:check": "node scripts/build-content.mjs --check",
    "verify": "npm run content:check && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "animejs": "4.5.0",
    "clsx": "2.1.1",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ts-fsrs": "6.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
